# 私钥和证书容器禁止进入版本库；公开证书链可以显式保留。
certs/*.key
certs/*.p12
certs/*.pfx
certs/*.pem
certs/*.csr
certs/*.crt
!certs/*_bundle.pem

launch/log/*
launch/runtime/*
